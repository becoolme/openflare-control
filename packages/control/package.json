{
  "name": "openflare-control",
  "version": "0.7.1",
  "description": "Portable cell control plane for the VRT Workers runtime: wire contract, ports, desired-state construction and signing",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.10.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/becoolme/openflare-control.git",
    "directory": "packages/control"
  },
  "bugs": {
    "url": "https://github.com/becoolme/openflare-control/issues"
  },
  "homepage": "https://github.com/becoolme/openflare-control#readme"
}
