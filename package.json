{
  "name": "openflare-control",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter openflare-control build && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "publint --strict packages/control",
    "check:openflare-contract": "node scripts/check-openflare-contract.mjs",
    "check:package-consumption": "node scripts/check-package-consumption.mjs",
    "test:e2e:docker": "node scripts/e2e-docker.mjs",
    "sync:openflare-contract": "node scripts/check-openflare-contract.mjs --write",
    "check:sanitized": "node scripts/check-sanitized.mjs",
    "test:scripts": "node --test scripts/test/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "publint": "^0.3.25",
    "smol-toml": "^1.9.1",
    "typescript": "^5.7.2",
    "yaml": "^2.9.1"
  },
  "type": "module"
}
