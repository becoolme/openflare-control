{
  "name": "openflare-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Reference control plane for the VRT Workers runtime (Postgres, single owner)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "maintain": "tsx src/maintain.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "openflare-control": "workspace:*",
    "hono": "^4.6.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/becoolme/openflare-control.git",
    "directory": "apps/plane"
  },
  "bugs": {
    "url": "https://github.com/becoolme/openflare-control/issues"
  },
  "homepage": "https://github.com/becoolme/openflare-control#readme"
}
