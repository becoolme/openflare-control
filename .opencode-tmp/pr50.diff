+    expect(report.objectsDeleted).toBeGreaterThanOrEqual(1)
+    expect(
+      (
+        await pool.query(
+          "select count(*)::int as n from plane_asset_manifests where digest='not-a-digest'"
+        )
+      ).rows[0]!.n
+    ).toBe(0)
+    expect(
+      (
+        await pool.query(
+          "select count(*)::int as n from plane_asset_objects where digest='also-bad'"
+        )
+      ).rows[0]!.n
+    ).toBe(0)
+  })
 })
